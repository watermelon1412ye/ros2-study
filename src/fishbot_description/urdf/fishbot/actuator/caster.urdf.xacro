<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="../common_inertia.xacro" />

    <xacro:macro name="caster_xacro" params="caster_name xyz">
        <link name="${caster_name}_caster_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.016" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.016" />
                </geometry>
            </collision>
            <xacro:sphere_inertia m="0.05" r="0.016" />
        </link>
        <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link" />
            <child link="${caster_name}_caster_link" />
            <origin xyz="${xyz}" />
        </joint>

        <!-- Gazebo 物理属性配置（摩擦力为零，仅支撑作用） -->
        <gazebo reference="${caster_name}_caster_link">
            <mu1 value="0.0" />           <!-- 切向摩擦系数 = 0 -->
            <mu2 value="0.0" />           <!-- 法向摩擦系数 = 0 -->
            <kp value="1000000000.0" />   <!-- 接触刚度系数 -->
            <kd value="1.0" />            <!-- 阻尼系数 -->
        </gazebo>
        
    </xacro:macro>

</robot>